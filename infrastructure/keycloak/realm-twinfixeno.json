{
  "realm": "twinfixeno",
  "enabled": true,
  "displayName": "twinfixeno Development",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "twinfixeno-admin",
        "description": "Development platform administrator"
      },
      {
        "name": "clinician",
        "description": "Authorised clinical workspace user"
      },
      {
        "name": "researcher",
        "description": "Authorised synthetic-data researcher"
      }
    ]
  },
  "clients": [
    {
      "clientId": "twinfixeno-web",
      "name": "twinfixeno Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocolMappers": [
        {
          "name": "twinfixeno API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "twinfixeno-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "twinfixeno-api",
      "name": "twinfixeno API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "demo.clinician",
      "enabled": true,
      "email": "demo.clinician@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Clinician",
      "credentials": [
        {
          "type": "password",
          "value": "Demo-Only-Change-Me-2026!",
          "temporary": true
        }
      ],
      "realmRoles": [
        "clinician"
      ]
    },
    {
      "username": "demo.admin",
      "enabled": true,
      "email": "demo.admin@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "admin",
      "credentials": [
        {
          "type": "password",
          "value": "Demo-Admin-Change-Me-2026!",
          "temporary": true
        }
      ],
      "realmRoles": [
        "twinfixeno-admin"
      ]
    },
    {
      "username": "demo.researcher",
      "enabled": true,
      "email": "demo.researcher@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "researcher",
      "credentials": [
        {
          "type": "password",
          "value": "Demo-Research-Change-Me-2026!",
          "temporary": true
        }
      ],
      "realmRoles": [
        "researcher"
      ]
    }
  ]
}
