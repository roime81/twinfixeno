# LOCAL SYNTHETIC-DATA ENVIRONMENT ONLY.
# DATABASE_URL is derived from POSTGRES_USER/PASSWORD/DB. Set it only to override with an external database.
# Replace secrets and configure TLS, identity, FHIR persistence, backups and governance before production.
POSTGRES_DB=twinfixeno
POSTGRES_USER=twinfixeno
POSTGRES_PASSWORD=local-development-only

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-before-use
KEYCLOAK_DB_PASSWORD=local-keycloak-password
KEYCLOAK_ISSUER=http://localhost:8081/realms/twinfixeno
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/twinfixeno/protocol/openid-connect/certs
JWT_AUDIENCE=twinfixeno-api
AUTH_REQUIRED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FHIR_BASE_URL=http://fhir:8080/fhir

# Browser-visible runtime settings. These are served from /runtime-config.
WEB_API_BASE_URL=http://localhost:9080
WEB_KEYCLOAK_URL=http://localhost:8081
WEB_KEYCLOAK_REALM=twinfixeno
WEB_KEYCLOAK_CLIENT_ID=twinfixeno-web

# Optional loopback host port overrides.
WEB_PORT=3000
API_PORT=8000
APISIX_PORT=9080
KEYCLOAK_PORT=8081
FHIR_PORT=8090

# Local open-source AI bundle; models download automatically on first startup.
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_PORT=11434
QDRANT_PORT=6333
MCP_PORT=8001
